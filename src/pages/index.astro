---
import Layout from "../layouts/Layout.astro";
---

<head>
	<title>seafloorsegue</title>
	<meta name="description" content="A series of deep-sea tubes." />
</head>

<Layout>
	<main>
		<header class="word-header">
			<h1>seafloorsegue</h1>
			<span class="pronunciation">/sē flôr sĕg′wā″/</span>
		</header>

		<p class="word-class">noun</p>

		<ol>
			<li>A series of deep-sea tubes.</li>
			<li>Website for stuff I wanna host on the internet.</li>
			<!-- <li><a href="/blog">My personal blog.</a></li> -->
			<li><a href="/minecraftSMP">My Minecraft server.</a></li>
		</ol>
	</main>
</Layout>

<style>
	body {
		background: #111111;
    	color: #eeeeee;
    	font-family: sans-serif;
    	margin: 0;
    	min-height: 100vh;
    	display: grid;
    	place-items: center;
  	}

	main {
    	max-width: 700px;
    	padding: 2rem;
  	}

	.word-header {
    	display: flex;
    	flex-wrap: wrap;
    	align-items: baseline;
    	column-gap: 12px;
  	}

	h1 {
    	font-size: 3rem;
	}

	.word-header h1 {
    	margin: 0px;
	}

	span {
    	color: #aaaaaa;
  	}

	p {
		color: #eeeeee;
		line-height: 1.7;
	}

	.word-class{
		font-weight: bold;
		margin: 0;
		line-height: 1.7;
	}

	ol {
		margin: 0;
	}

	li {
		padding-left: 0.7rem;
		line-height: 2rem;
	}

	li::marker {
		color: #888888;
	}

	a {
		color: #eeeeee;
		font-weight: bold;
		font-style: italic;
		text-decoration: none;
	}

  	a:hover {
    	text-decoration: underline;
  	}

	/* * {
    	outline: 1px solid red !important;
	} */
</style>