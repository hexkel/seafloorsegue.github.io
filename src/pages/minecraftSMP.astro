---
import Layout from "../layouts/Layout.astro";
---

<head>
  <title>seafloorsegueSMP</title>
  <meta name="description" content="A series of deep-sea tubes." />
</head>

<Layout>
    <main>
        <a class="button" href="/">Back</a>
        <header class="word-header">
			<h1>seafloorsegueSMP</h1>
			<span class="pronunciation">/smp.seafloorsegue.net/</span>
		</header>

        <p class="word-class">A Modded Minecraft: Java Edition 26.3 Survival Multiplayer Server</p>
		<ol>
			<li><a href="https://map.seafloorsegue.net" target="_blank" rel="noopener noreferrer">map.seafloorsegue.net</a></li>
		</ol>
		
		<p></p>

        <p class="word-class">Instructions</p>
        <ol>
            <li><a href="https://prismlauncher.org/download/">Download Prism Launcher.</a></li>
            <li>Open it and sign in to your Microsoft account. <span>(you must own Minecraft: Java Edition)</span></li>
            <li>Click "Add Instance" in the top left.</li>
            <li>Go to "Import from zip" then paste the following into the field:
				<div class="copy-box">
  					<code id="server-ip">https://seafloorsegue.net/download/seafloorsegueSMP-modpack.zip</code>
  				<button class="copy-btn" data-copy="server-ip">Copy</button>
				</div>
			</li>
            <li>Launch the instance after the download completes</li>
            <li>The server should appear in Multiplayer, join and have fun!</li>
        </ol>
    </main>
</Layout>

<style>
  body {
    background: #111111;
    color: #eeeeee;
    font-family: sans-serif;
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
  }

  main {
    max-width: 700px;
    padding: 2rem;
  }

  .button {
	color: #4c4c4c;
	font-style: italic;
	margin-bottom: 1rem;
  }

  .word-header {
    	display: flex;
    	flex-wrap: wrap;
    	align-items: baseline;
    	gap: 12px;
  	}

	h1 {
    	font-size: 3rem;
	}

	.word-header h1 {
    	margin: 0px;
	}

	span {
    	color: #aaaaaa;
  	}

	.word-header span {
		height: 2rem;
	}

	p {
		color: #eeeeee; line-height: 1.7;
	}

	p + p {
  		margin-top: 2.4rem;
	}

	.word-class{
		line-height: 0rem;
		font-weight: bold;
	}

	li {
		padding-left: 0.7rem;
		line-height: 2rem;
	}

	li::marker {
		color: #888888;
	}

	a {
		color: #eeeeee;
		font-weight: bold;
		font-style: italic;
		text-decoration: none;
	}

  	a:hover {
    	text-decoration: underline;
  	}

	.copy-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid #444;
		border-radius: 12px;
		background: #111;
	}

	.copy-box code {
		overflow-wrap: anywhere;
		color: #fff;
	}

	.copy-btn {
		padding: 0.4rem 0.8rem;
		background: #333;
		color: white;
		border: none;
		border-radius: 4px;
		cursor: pointer;
	}

	.copy-btn:hover {
		background: #555;
	}

	.copy-btn:active {
		background: #777;
	}
</style>